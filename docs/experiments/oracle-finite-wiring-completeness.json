  "scope": {
    "circuits": "One-sort strict finite-product terms: identity, scalar projection, finite tuple, sequential composition, and explicit tensor.",
    "routing": "For n inputs and m outputs, a function Fin m -> Fin n. Repeated indices are copies, omitted indices are discarded.",
    "normal_form": "Tuple of scalar projections selected by routing. The recursive normalizer constructs a Cell using only the eight local schemata and context closure.",
    "not_a_reconstruction_generator": true,
    "endpoint_equality": "connect accepts equality of normal routing functions only to cast endpoints; the actual path is built by normalize. synthesize computes the finite routing equality itself.",
    "finite_means": "Eight schematic root forms with arbitrary finite arities and term parameters, not a finite set of concrete cells. Tuples and projections are primitive syntax; this is not a gate-only binary-copy/delete/symmetry presentation.",
    "shape_compilation": "All twelve previous structural Wire constructors on Shape Unit, interpreted in a single arbitrary atomic type. Nested products flatten to arrays; seq and tensor nodes are retained compositionally.",
    "all_models": "Completeness quantifies over every atomic type and every input value or input PMF, not equality in a selected singleton-reference model.",
    "no_stochastic_operation_boxes": true,
    "no_heterogeneous_inference_rule_boxes": true,
    "no_higher_coherence_claim": true
  },
  "verified_old_boundary": {
