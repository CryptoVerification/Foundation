    "program": "import Foundation.Examples.MixedCircuitTensorObservation\nopen Foundation.Logic.Polygraph\nopen Foundation.Logic.Polygraph.StructuralTransport\nopen CryptoLogic.Polygraph.MixedCircuit.Examples.MAC.TensorObservation\n\ndef rootCode {Atom : Type} {a b : Shape Atom} : {p q : Wire a b} → Cartesian.Step p q → Nat\n  | _, _, .root change => change.code.val\n  | _, _, .seqLeft child _ | _, _, .seqRight _ child | _, _, .tensorLeft child _ | _, _, .tensorRight _ child => rootCode child\n\ndef trace {Atom : Type} {a b : Shape Atom} : {p q : Wire a b} → Cartesian.ProofTrack p q → List (Nat × Bool)\n  | _, _, .refl _ => []\n  | _, _, .step change => [(rootCode change, true)]\n  | _, _, .comp first second => trace first ++ trace second\n  | _, _, .inv child => (trace child).reverse.map (fun (code, forward) => (code, !forward))\n\ndef profile {Atom : Type} {a b : Shape Atom} {p q : Wire a b} (path : Cartesian.ProofTrack p q) : IO Unit := do\n  IO.println s!\"leaves {(trace path).length}\"\n  for code in List.range 18 do\n    let forward := ((trace path).filter (fun pair => pair.1 == code && pair.2)).length\n    let backward := ((trace path).filter (fun pair => pair.1 == code && !pair.2)).length\n    IO.println s!\"{code},{forward},{backward}\"\n#eval profile obstructedFirst\n#eval profile obstructedSecond\n",
