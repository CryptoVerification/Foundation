import Foundation.Crypto.Semantics.Oracle.StatefulDiagramSlice

/-! Decidable side conditions for exchanging probabilistic state-update boxes.
Shared state is allowed globally; exchanged boxes must have no read/write or
write/write interference. This is a sufficient rule, not a complete commutation
decision procedure or a new separation principle. -/
namespace CryptoOracle.StatefulDiagram
open Foundation.Probability
variable {Slot Op Value : Type} [DecidableEq Slot]

def Independent (signature : Op → Interface Slot) (first second : Op) : Prop :=
  Disjoint (signature first).writes (signature second).reads ∧
  Disjoint (signature second).writes (signature first).reads ∧
  Disjoint (signature first).writes (signature second).writes

instance (signature : Op → Interface Slot) (first second : Op) : Decidable (Independent signature first second) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))

def checkExchange (signature : Op → Interface Slot) (first second : Op) : Bool := decide (Independent signature first second)

theorem view_write_disjoint (readScope writeScope : Finset Slot) (store : Store Slot Value)
    (values : writeScope → Value) (separate : Disjoint writeScope readScope) :
    view readScope (write writeScope store values) = view readScope store := by
  funext slot
  have outside : (slot : Slot) ∉ writeScope :=
    fun member => Finset.disjoint_left.mp separate member slot.property
  simp only [view, write, dif_neg outside]

theorem write_commute (one two : Finset Slot) (store : Store Slot Value)
    (first : one → Value) (second : two → Value) (separate : Disjoint one two) :
    write two (write one store first) second = write one (write two store second) first := by
  funext slot
  by_cases inOne : slot ∈ one
  · have outTwo : slot ∉ two := fun member => Finset.disjoint_left.mp separate inOne member
    simp only [write, dif_neg outTwo, dif_pos inOne]
  · by_cases inTwo : slot ∈ two
    · simp only [write, dif_neg inOne, dif_pos inTwo]
    · simp only [write, dif_neg inOne, dif_neg inTwo]

/-- Exchange retains the entire store, not only selected observations. -/
theorem exchange_sound (signature : Op → Interface Slot) (world : Kernels signature Value)
    (first second : Op) (store : Store Slot Value) (independent : Independent signature first second) :
    execute signature world [first, second] store = execute signature world [second, first] store := by
  rcases independent with ⟨readSecond, readFirst, writes⟩
  simp only [execute, step, PMF.bind_pure, PMF.bind_map, Function.comp_def]
  simp only [view_write_disjoint _ _ _ _ readSecond, view_write_disjoint _ _ _ _ readFirst]
  simp only [PMF.map]
  rw [PMF.bind_comm]
  congr 1
  funext secondValues
  congr 1
  funext firstValues
  simp only [Function.comp_def]
  rw [write_commute _ _ _ _ _ writes]

theorem checkExchange_sound (signature : Op → Interface Slot) (world : Kernels signature Value)
    (first second : Op) (store : Store Slot Value) (accepted : checkExchange signature first second = true) :
    execute signature world [first, second] store = execute signature world [second, first] store :=
  exchange_sound signature world first second store (of_decide_eq_true accepted)

theorem execute_append (signature : Op → Interface Slot) (world : Kernels signature Value)
    (first second : List Op) (store : Store Slot Value) :
    execute signature world (first ++ second) store =
      (execute signature world first store).bind (execute signature world second) := by
  induction first generalizing store with
  | nil => simp only [List.nil_append, execute, PMF.pure_bind]
  | cons op rest ih =>
      simp only [List.cons_append, execute, PMF.bind_bind]
      congr 1
      funext next
      exact ih next

/-- The surrounding execution, including any shared cache, stays in place. -/
theorem exchange_in_context (signature : Op → Interface Slot) (world : Kernels signature Value)
    (past future : List Op) (first second : Op) (store : Store Slot Value)
    (accepted : checkExchange signature first second = true) :
    execute signature world (past ++ [first, second] ++ future) store =
      execute signature world (past ++ [second, first] ++ future) store := by
  simp only [execute_append]
  apply congrArg (fun (law : PMF (Store Slot Value)) => law.bind (execute signature world future))
  apply congrArg (fun (continuation : Store Slot Value → PMF (Store Slot Value)) => (execute signature world past store).bind continuation)
  funext prefixState
  exact checkExchange_sound signature world first second prefixState accepted

/-- Explicit equation paths generated by the checked two-box exchange rule. -/
inductive Exchange (signature : Op → Interface Slot) : List Op → List Op → Type where
  | refl (diagram : List Op) : Exchange signature diagram diagram
  | swap (past future : List Op) (first second : Op)
      (accepted : checkExchange signature first second = true) :
      Exchange signature (past ++ [first, second] ++ future) (past ++ [second, first] ++ future)
  | symm {one two} : Exchange signature one two → Exchange signature two one
  | trans {one two three} : Exchange signature one two → Exchange signature two three → Exchange signature one three

def attemptExchange (signature : Op → Interface Slot) (past future : List Op) (first second : Op) :
    Option (Exchange signature (past ++ [first, second] ++ future) (past ++ [second, first] ++ future)) :=
  if accepted : checkExchange signature first second = true then some (.swap past future first second accepted) else none

theorem Exchange.sound (signature : Op → Interface Slot) {one two : List Op}
    (certificate : Exchange signature one two) (world : Kernels signature Value) (store : Store Slot Value) :
    execute signature world one store = execute signature world two store := by
  induction certificate with
  | refl => rfl
  | swap past future first second accepted => exact exchange_in_context signature world past future first second store accepted
  | symm certificate ih => exact ih.symm
  | trans first second ihFirst ihSecond => exact ihFirst.trans ihSecond

end CryptoOracle.StatefulDiagram
