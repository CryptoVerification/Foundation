import Foundation.Crypto.Semantics.Oracle.StatefulDiagramCanonical
import Foundation.Crypto.Semantics.Oracle.StatefulDiagramInverseCells
import Foundation.Crypto.Semantics.Oracle.StatefulDiagramHigherBoundary

/-! Horizontal path composition and interchange generated by a separated
primitive-exchange square. Each new root boundary has exactly two swaps;
unchanged context between the two active pairs is arbitrary. No arbitrary
parallel-path or normalizer-relative higher root is introduced. -/
namespace CryptoOracle.StatefulDiagram
variable {Slot Op : Type} [DecidableEq Slot]

def Exchange.prefix (signature : Op → Interface Slot) : (past : List Op) → {one two : List Op} →
    Exchange signature one two → Exchange signature (past ++ one) (past ++ two)
  | [], _, _, path => path
  | head :: tail, _, _, path => (path.prefix signature tail).prepend signature head

def Exchange.suffix (signature : Op → Interface Slot) {one two : List Op}
    (path : Exchange signature one two) (future : List Op) :
    Exchange signature (one ++ future) (two ++ future) := path.whisker signature [] future

theorem Exchange.suffix_trans (signature : Op → Interface Slot) (future : List Op) {a b c : List Op}
    (p : Exchange signature a b) (q : Exchange signature b c) :
    (p.trans q).suffix signature future = (p.suffix signature future).trans (q.suffix signature future) := rfl

theorem Exchange.suffix_symm (signature : Op → Interface Slot) (future : List Op) {a b : List Op}
    (p : Exchange signature a b) : (p.symm).suffix signature future = (p.suffix signature future).symm := rfl

theorem Exchange.suffix_refl (signature : Op → Interface Slot) (future word : List Op) :
    (Exchange.refl word).suffix signature future = .refl (word ++ future) := rfl

theorem Exchange.prefix_trans (signature : Op → Interface Slot) (past : List Op) {a b c : List Op}
    (p : Exchange signature a b) (q : Exchange signature b c) :
    (p.trans q).prefix signature past = (p.prefix signature past).trans (q.prefix signature past) := by
  induction past with
  | nil => rfl
  | cons head tail ih => simp only [Exchange.prefix, ih, Exchange.prepend]

theorem Exchange.prefix_symm (signature : Op → Interface Slot) (past : List Op) {a b : List Op}
    (p : Exchange signature a b) : (p.symm).prefix signature past = (p.prefix signature past).symm := by
  induction past with
  | nil => rfl
  | cons head tail ih => simp only [Exchange.prefix, ih, Exchange.prepend]

theorem Exchange.prefix_refl (signature : Op → Interface Slot) (past word : List Op) :
    (Exchange.refl word).prefix signature past = .refl (past ++ word) := by
  induction past with
  | nil => rfl
  | cons head tail ih => simp only [Exchange.prefix, ih, Exchange.prepend, List.cons_append]

theorem Exchange.prefix_count (signature : Op → Interface Slot) (past : List Op) {a b : List Op}
    (p : Exchange signature a b) : (p.prefix signature past).swapCount signature = p.swapCount signature := by
  induction past with
  | nil => rfl
  | cons head tail ih => simp only [Exchange.prefix, Exchange.prepend_count, ih]

theorem Exchange.suffix_count (signature : Op → Interface Slot) {a b : List Op}
    (p : Exchange signature a b) (future : List Op) :
    (p.suffix signature future).swapCount signature = p.swapCount signature :=
  p.swapCount_whisker signature [] future

/-- First transform the left component, then the right component. -/
def horizontalLeft (signature : Op → Interface Slot) {a b c d : List Op}
    (p : Exchange signature a b) (q : Exchange signature c d) : Exchange signature (a ++ c) (b ++ d) :=
  (p.suffix signature c).trans (q.prefix signature b)

/-- First transform the right component, then the left component. -/
def horizontalRight (signature : Op → Interface Slot) {a b c d : List Op}
    (p : Exchange signature a b) (q : Exchange signature c d) : Exchange signature (a ++ c) (b ++ d) :=
  (q.prefix signature a).trans (p.suffix signature d)

/-- Extension by the separated primitive square and compositional closure.
The new root does not take arbitrary paths as arguments. -/
inductive HorizontalCoherence (signature : Op → Interface Slot) : {one two : List Op} →
    Exchange signature one two → Exchange signature one two → Type where
  | base {one two} {p q : Exchange signature one two} :
      ExchangeCoherence signature p q → HorizontalCoherence signature p q
  | refl {one two} (p : Exchange signature one two) : HorizontalCoherence signature p p
  | symm {one two} {p q : Exchange signature one two} :
      HorizontalCoherence signature p q → HorizontalCoherence signature q p
  | trans {one two} {p q r : Exchange signature one two} :
      HorizontalCoherence signature p q → HorizontalCoherence signature q r → HorizontalCoherence signature p r
  | comp {a b c} {p p' : Exchange signature a b} {q q' : Exchange signature b c} :
      HorizontalCoherence signature p p' → HorizontalCoherence signature q q' →
      HorizontalCoherence signature (.trans p q) (.trans p' q')
  | inverse {one two} {p q : Exchange signature one two} :
      HorizontalCoherence signature p q → HorizontalCoherence signature (.symm p) (.symm q)
  | prefix {one two} {p q : Exchange signature one two} (past : List Op) :
      HorizontalCoherence signature p q → HorizontalCoherence signature (p.prefix signature past) (q.prefix signature past)
  | suffix {one two} {p q : Exchange signature one two} (future : List Op) :
      HorizontalCoherence signature p q → HorizontalCoherence signature (p.suffix signature future) (q.suffix signature future)
  | separated (pastLeft futureLeft pastRight futureRight : List Op) (a b c d : Op)
      (ab : checkExchange signature a b = true) (cd : checkExchange signature c d = true) :
      HorizontalCoherence signature
        (horizontalLeft signature (.swap pastLeft futureLeft a b ab) (.swap pastRight futureRight c d cd))
        (horizontalRight signature (.swap pastLeft futureLeft a b ab) (.swap pastRight futureRight c d cd))

namespace HorizontalCoherence

def assoc (signature : Op → Interface Slot) {a b c d : List Op}
    (p : Exchange signature a b) (q : Exchange signature b c) (r : Exchange signature c d) :
    HorizontalCoherence signature (.trans (.trans p q) r) (.trans p (.trans q r)) := .base (.assoc p q r)

def undoSuffix (signature : Op → Interface Slot) {a b c : List Op}
    (p : Exchange signature a b) (q : Exchange signature b c) :
    HorizontalCoherence signature (.trans (.trans p q) (.symm q)) p := .base (StatefulDiagram.undoSuffix signature p q)

def undoForwardPrefix (signature : Op → Interface Slot) {a b c : List Op}
    (p : Exchange signature a b) (q : Exchange signature a c) :
    HorizontalCoherence signature (.trans p (.trans (.symm p) q)) q :=
  (assoc signature p (.symm p) q).symm.trans
    ((HorizontalCoherence.comp (.base (.rightInv p)) (.refl q)).trans (.base (.leftUnit q)))

def undoInversePrefix (signature : Op → Interface Slot) {a b c : List Op}
    (p : Exchange signature a b) (q : Exchange signature b c) :
    HorizontalCoherence signature (.trans (.symm p) (.trans p q)) q := .base (StatefulDiagram.undoPrefix signature p q)

def cancelPrefix (signature : Op → Interface Slot) {a b c : List Op}
    (r : Exchange signature a b) {p q : Exchange signature b c}
    (cell : HorizontalCoherence signature (.trans r p) (.trans r q)) : HorizontalCoherence signature p q :=
  (undoInversePrefix signature r p).symm.trans
    ((HorizontalCoherence.comp (.refl (.symm r)) cell).trans (undoInversePrefix signature r q))

/-- Invert the two horizontal sides of a supplied square by derived groupoid
operations. No inverse-square generator is assumed. -/
def invertSquare (signature : Op → Interface Slot) {a b c d : List Op}
    (p : Exchange signature a b) (s : Exchange signature b d)
    (r : Exchange signature a c) (q : Exchange signature c d)
    (cell : HorizontalCoherence signature (.trans p s) (.trans r q)) :
    HorizontalCoherence signature (.trans (.symm p) r) (.trans s (.symm q)) :=
  cancelPrefix signature p ((undoForwardPrefix signature p r).trans
    (((assoc signature p s (.symm q)).symm.trans
      ((HorizontalCoherence.comp cell (.refl (.symm q))).trans (undoSuffix signature r q))).symm))

/-- Paste two squares along their horizontal path boundaries. -/
def stackSquares (signature : Op → Interface Slot) {a b c d e f : List Op}
    {p₀ : Exchange signature a b} {p₁ : Exchange signature c d} {p₂ : Exchange signature e f}
    {l₀ : Exchange signature a c} {l₁ : Exchange signature c e}
    {r₀ : Exchange signature b d} {r₁ : Exchange signature d f}
    (first : HorizontalCoherence signature (.trans p₀ r₀) (.trans l₀ p₁))
    (second : HorizontalCoherence signature (.trans p₁ r₁) (.trans l₁ p₂)) :
    HorizontalCoherence signature (.trans p₀ (.trans r₀ r₁)) (.trans (.trans l₀ l₁) p₂) :=
  (assoc signature p₀ r₀ r₁).symm.trans
    ((HorizontalCoherence.comp first (.refl r₁)).trans
      ((assoc signature l₀ p₁ r₁).trans
        ((HorizontalCoherence.comp (.refl l₀) second).trans (assoc signature l₀ l₁ p₂).symm)))

/-- Paste two squares along their vertical path boundaries. -/
def composeSquares (signature : Op → Interface Slot) {a b c d e f : List Op}
    {p₀ : Exchange signature a b} {p₁ : Exchange signature b c}
    {q₀ : Exchange signature d e} {q₁ : Exchange signature e f}
    {l : Exchange signature a d} {middle : Exchange signature b e} {r : Exchange signature c f}
    (first : HorizontalCoherence signature (.trans p₀ middle) (.trans l q₀))
    (second : HorizontalCoherence signature (.trans p₁ r) (.trans middle q₁)) :
    HorizontalCoherence signature (.trans (.trans p₀ p₁) r) (.trans l (.trans q₀ q₁)) :=
  (assoc signature p₀ p₁ r).trans
    ((HorizontalCoherence.comp (.refl p₀) second).trans
      ((assoc signature p₀ middle q₁).symm.trans
        ((HorizontalCoherence.comp first (.refl q₁)).trans (assoc signature l q₀ q₁))))

def invertLeft (signature : Op → Interface Slot) {a b c d : List Op}
    {p : Exchange signature a b} {s : Exchange signature b d}
    {r : Exchange signature a c} {q : Exchange signature c d}
    (cell : HorizontalCoherence signature (.trans p s) (.trans r q)) :
    HorizontalCoherence signature (.trans (.symm p) r) (.trans s (.symm q)) :=
  invertSquare signature p s r q cell

def invertSecond (signature : Op → Interface Slot) {a b c d : List Op}
    {p : Exchange signature a b} {s : Exchange signature b d}
    {r : Exchange signature a c} {q : Exchange signature c d}
    (cell : HorizontalCoherence signature (.trans p s) (.trans r q)) :
    HorizontalCoherence signature (.trans q (.symm s)) (.trans (.symm r) p) :=
  (invertSquare signature r q p s cell.symm).symm

end HorizontalCoherence

/-- Derive interchange with an arbitrary right path from separated primitive
squares, composition and inverse transport. -/
def interchangeWithSwap (signature : Op → Interface Slot) (past future : List Op) (a b : Op)
    (ab : checkExchange signature a b = true) : {c d : List Op} → (q : Exchange signature c d) →
    HorizontalCoherence signature
      (horizontalLeft signature (.swap past future a b ab) q)
      (horizontalRight signature (.swap past future a b ab) q)
  | word, _, .refl _ => by
    let p := Exchange.swap past future a b ab
    simpa only [horizontalLeft, horizontalRight, Exchange.prefix_refl] using
      (HorizontalCoherence.base (ExchangeCoherence.rightUnit (p.suffix signature word))).trans
        (HorizontalCoherence.base (ExchangeCoherence.leftUnit (p.suffix signature word))).symm
  | _, _, .swap before after c d cd => .separated past future before after a b c d ab cd
  | _, _, .symm child => by
    simpa only [horizontalLeft, horizontalRight, Exchange.prefix_symm] using
      HorizontalCoherence.invertSecond signature (interchangeWithSwap signature past future a b ab child)
  | _, _, .trans first second => by
    simpa only [horizontalLeft, horizontalRight, Exchange.prefix_trans] using
      HorizontalCoherence.stackSquares signature
        (interchangeWithSwap signature past future a b ab first)
        (interchangeWithSwap signature past future a b ab second)

/-- Arbitrary finite checked paths on the two components can be applied in
either order. The comparison is generated, not assumed as a higher root. -/
def horizontalInterchange (signature : Op → Interface Slot) : {a b : List Op} → (p : Exchange signature a b) →
    {c d : List Op} → (q : Exchange signature c d) →
    HorizontalCoherence signature (horizontalLeft signature p q) (horizontalRight signature p q)
  | word, _, .refl _, _, _, q => by
    simpa only [horizontalLeft, horizontalRight, Exchange.suffix_refl] using
      (HorizontalCoherence.base (ExchangeCoherence.leftUnit (q.prefix signature word))).trans
        (HorizontalCoherence.base (ExchangeCoherence.rightUnit (q.prefix signature word))).symm
  | _, _, .swap past future a b ab, _, _, q => interchangeWithSwap signature past future a b ab q
  | _, _, .symm child, _, _, q => by
    simpa only [horizontalLeft, horizontalRight, Exchange.suffix_symm] using
      HorizontalCoherence.invertLeft signature (horizontalInterchange signature child q)
  | _, _, .trans first second, _, _, q => by
    simpa only [horizontalLeft, horizontalRight, Exchange.suffix_trans] using
      HorizontalCoherence.composeSquares signature
        (horizontalInterchange signature first q) (horizontalInterchange signature second q)

/-- Both boundaries of every separated primitive square have two expanded
swap occurrences, regardless of the intervening unchanged context. -/
theorem separated_boundary_counts (signature : Op → Interface Slot)
    (pastLeft futureLeft pastRight futureRight : List Op) (a b c d : Op)
    (ab : checkExchange signature a b = true) (cd : checkExchange signature c d = true) :
    (horizontalLeft signature (.swap pastLeft futureLeft a b ab) (.swap pastRight futureRight c d cd)).swapCount signature = 2 ∧
    (horizontalRight signature (.swap pastLeft futureLeft a b ab) (.swap pastRight futureRight c d cd)).swapCount signature = 2 := by
  simp only [horizontalLeft, horizontalRight, Exchange.swapCount, Exchange.prefix_count, Exchange.suffix_count]
  exact ⟨True.intro, True.intro⟩

/-- Count only uses of the new separated primitive square. This does not
count structural laws, embedded old diagrams, context bytes or checking time. -/
def HorizontalCoherence.squareCount (signature : Op → Interface Slot) : {a b : List Op} →
    {p q : Exchange signature a b} → HorizontalCoherence signature p q → Nat
  | _, _, _, _, .base _ => 0
  | _, _, _, _, .refl _ => 0
  | _, _, _, _, .symm child => child.squareCount signature
  | _, _, _, _, .trans first second => first.squareCount signature + second.squareCount signature
  | _, _, _, _, .comp first second => first.squareCount signature + second.squareCount signature
  | _, _, _, _, .inverse child => child.squareCount signature
  | _, _, _, _, .prefix _ child => child.squareCount signature
  | _, _, _, _, .suffix _ child => child.squareCount signature
  | _, _, _, _, .separated _ _ _ _ _ _ _ _ _ _ => 1

namespace HorizontalCoherence

theorem stackSquares_count (signature : Op → Interface Slot) {a b c d e f : List Op}
    {p₀ : Exchange signature a b} {p₁ : Exchange signature c d} {p₂ : Exchange signature e f}
    {l₀ : Exchange signature a c} {l₁ : Exchange signature c e}
    {r₀ : Exchange signature b d} {r₁ : Exchange signature d f}
    (first : HorizontalCoherence signature (.trans p₀ r₀) (.trans l₀ p₁))
    (second : HorizontalCoherence signature (.trans p₁ r₁) (.trans l₁ p₂)) :
    (stackSquares signature first second).squareCount signature = first.squareCount signature + second.squareCount signature := by
  simp [stackSquares, assoc, squareCount]

theorem composeSquares_count (signature : Op → Interface Slot) {a b c d e f : List Op}
    {p₀ : Exchange signature a b} {p₁ : Exchange signature b c}
    {q₀ : Exchange signature d e} {q₁ : Exchange signature e f}
    {l : Exchange signature a d} {middle : Exchange signature b e} {r : Exchange signature c f}
    (first : HorizontalCoherence signature (.trans p₀ middle) (.trans l q₀))
    (second : HorizontalCoherence signature (.trans p₁ r) (.trans middle q₁)) :
    (composeSquares signature first second).squareCount signature = first.squareCount signature + second.squareCount signature := by
  simp [composeSquares, assoc, squareCount, Nat.add_comm]

theorem invertLeft_count (signature : Op → Interface Slot) {a b c d : List Op}
    {p : Exchange signature a b} {s : Exchange signature b d}
    {r : Exchange signature a c} {q : Exchange signature c d}
    (cell : HorizontalCoherence signature (.trans p s) (.trans r q)) :
    (invertLeft signature cell).squareCount signature = cell.squareCount signature := by
  simp [invertLeft, invertSquare, cancelPrefix, undoInversePrefix, undoForwardPrefix, undoSuffix, assoc, squareCount]

theorem invertSecond_count (signature : Op → Interface Slot) {a b c d : List Op}
    {p : Exchange signature a b} {s : Exchange signature b d}
    {r : Exchange signature a c} {q : Exchange signature c d}
    (cell : HorizontalCoherence signature (.trans p s) (.trans r q)) :
    (invertSecond signature cell).squareCount signature = cell.squareCount signature := by
  simp [invertSecond, invertSquare, cancelPrefix, undoInversePrefix, undoForwardPrefix, undoSuffix, assoc, squareCount]

end HorizontalCoherence

private theorem squareCount_heq (signature : Op → Interface Slot) {a b : List Op}
    {p q p' q' : Exchange signature a b} (left : p = p') (right : q = q')
    {cell : HorizontalCoherence signature p q} {other : HorizontalCoherence signature p' q'}
    (same : HEq cell other) : cell.squareCount signature = other.squareCount signature := by
  cases left
  cases right
  exact congrArg (HorizontalCoherence.squareCount signature) (eq_of_heq same)

theorem interchangeWithSwap_count (signature : Op → Interface Slot) (past future : List Op) (a b : Op)
    (ab : checkExchange signature a b = true) {c d : List Op} (q : Exchange signature c d) :
    (interchangeWithSwap signature past future a b ab q).squareCount signature = q.swapCount signature := by
  induction q with
  | refl word =>
    let p := Exchange.swap past future a b ab
    let cell := (HorizontalCoherence.base (ExchangeCoherence.rightUnit (p.suffix signature word))).trans
      (HorizontalCoherence.base (ExchangeCoherence.leftUnit (p.suffix signature word))).symm
    have count := squareCount_heq signature
      (by simp only [horizontalLeft, Exchange.prefix_refl, p])
      (by simp only [horizontalRight, Exchange.prefix_refl, p])
      (cell := interchangeWithSwap signature past future a b ab (.refl word)) (other := cell)
      (by simp only [interchangeWithSwap]; exact cast_heq _ _)
    exact count
  | swap => rfl
  | symm child ih =>
    have count := squareCount_heq signature
      (by simp only [horizontalLeft, Exchange.prefix_symm])
      (by simp only [horizontalRight, Exchange.prefix_symm])
      (cell := interchangeWithSwap signature past future a b ab (.symm child))
      (other := HorizontalCoherence.invertSecond signature (interchangeWithSwap signature past future a b ab child))
      (by simp only [interchangeWithSwap]; exact cast_heq _ _)
    exact count.trans ((HorizontalCoherence.invertSecond_count signature _).trans ih)
  | trans first second ihFirst ihSecond =>
    have count := squareCount_heq signature
      (by simp only [horizontalLeft, Exchange.prefix_trans])
      (by simp only [horizontalRight, Exchange.prefix_trans])
      (cell := interchangeWithSwap signature past future a b ab (.trans first second))
      (other := HorizontalCoherence.stackSquares signature
        (interchangeWithSwap signature past future a b ab first)
        (interchangeWithSwap signature past future a b ab second))
      (by simp only [interchangeWithSwap]; exact cast_heq _ _)
    exact count.trans ((HorizontalCoherence.stackSquares_count signature _ _).trans (congrArg₂ Nat.add ihFirst ihSecond))

theorem horizontalInterchange_count (signature : Op → Interface Slot) {a b c d : List Op}
    (p : Exchange signature a b) (q : Exchange signature c d) :
    (horizontalInterchange signature p q).squareCount signature = p.swapCount signature * q.swapCount signature := by
  induction p with
  | refl => simp only [horizontalInterchange, id, HorizontalCoherence.squareCount, Exchange.swapCount, Nat.zero_mul]
  | swap => simpa only [horizontalInterchange, Exchange.swapCount, Nat.one_mul] using interchangeWithSwap_count signature _ _ _ _ _ q
  | symm child ih =>
    change (HorizontalCoherence.invertLeft signature (horizontalInterchange signature child q)).squareCount signature = _
    exact (HorizontalCoherence.invertLeft_count signature _).trans ih
  | trans first second ihFirst ihSecond =>
    change (HorizontalCoherence.composeSquares signature
      (horizontalInterchange signature first q) (horizontalInterchange signature second q)).squareCount signature = _
    have count := HorizontalCoherence.composeSquares_count signature
      (horizontalInterchange signature first q) (horizontalInterchange signature second q)
    have sum := congrArg₂ (fun (x y : Nat) => x + y) ihFirst ihSecond
    exact count.trans (sum.trans (Nat.add_mul (first.swapCount signature) (second.swapCount signature)
      (q.swapCount signature)).symm)


/-- With no intervening context, the old four-box root already supplies the
comparison. Thus squareCount is construction-specific, not minimal size. -/
def adjacentInterchangeOld (signature : Op → Interface Slot) (a b c d : Op)
    (ab : checkExchange signature a b = true) (cd : checkExchange signature c d = true) :
    HorizontalCoherence signature
      (horizontalLeft signature (.swap [] [] a b ab) (.swap [] [] c d cd))
      (horizontalRight signature (.swap [] [] a b ab) (.swap [] [] c d cd)) :=
  .base (.local (.original (.far a b c d ab cd)))

theorem adjacentInterchangeOld_count (signature : Op → Interface Slot) (a b c d : Op)
    (ab : checkExchange signature a b = true) (cd : checkExchange signature c d = true) :
    (adjacentInterchangeOld signature a b c d ab cd).squareCount signature = 0 := rfl

/-- Both edit orders retain the same shared store, arbitrary probabilistic
kernels and intervening computation. No independence across components is
assumed beyond the checked exchanges inside each supplied path. -/
theorem horizontal_execution_sound {Value : Type} (signature : Op → Interface Slot)
    {a b c d : List Op} (p : Exchange signature a b) (q : Exchange signature c d)
    (world : Kernels signature Value) (store : Store Slot Value) :
    execute signature world (a ++ c) store = execute signature world (b ++ d) store :=
  (horizontalLeft signature p q).sound signature world store

theorem horizontal_obligations [DecidableEq Op] (signature : Op → Interface Slot)
    {a b c d : List Op} (p : Exchange signature a b) (q : Exchange signature c d)
    (needed : Finset Slot) (changed : Finset Op) :
    obligations signature (a ++ c) needed changed = obligations signature (b ++ d) needed changed :=
  (horizontalLeft signature p q).obligations_eq signature needed changed

end CryptoOracle.StatefulDiagram
