import Foundation.Crypto.Semantics.Oracle.InformationSchedule

/-! Cells generated by dependency-safe exchanges of visibility and commitment
instructions. No arbitrary equality of whole kernels is a generating cell. -/
namespace CryptoOracle.InformationSchedule
open Foundation.Probability
set_option backward.isDefEq.respectTransparency false
variable {Variable Key : Type} [DecidableEq Variable] [DecidableEq Key]
variable (signature : Key → Finset Variable)

inductive Cell : List (Action Variable Key) → List (Action Variable Key) → Type where
  | refl (word) : Cell word word
  | exchange (first second) (allowed : independent signature first second = true) (rest) :
      Cell (first :: second :: rest) (second :: first :: rest)
  | cons (action) {first second} : Cell first second → Cell (action :: first) (action :: second)
  | symm {first second} : Cell first second → Cell second first
  | trans {first middle last} : Cell first middle → Cell middle last → Cell first last

variable {Choice : Type} (policy : (key : Key) → ({v // v ∈ signature key} → Bool) → PMF Choice)

theorem Cell.sound {first second} (cell : Cell signature first second) (state : State Variable Key Choice) :
    run signature policy first state = run signature policy second state := by
  induction cell generalizing state with
  | refl => rfl
  | exchange first second allowed rest =>
      change (step signature policy first state).bind
        (fun next => (step signature policy second next).bind (run signature policy rest)) = _
      rw [← PMF.bind_bind, step_exchange signature policy first second allowed]
      exact PMF.bind_bind _ _ _
  | cons action cell ih => exact congrArg (PMF.bind (step signature policy action state)) (funext ih)
  | symm cell ih => exact (ih state).symm
  | trans first second ihFirst ihSecond => exact (ihFirst state).trans (ihSecond state)

theorem Cell.scan {first second} (cell : Cell signature first second) (seen : Finset Variable) :
    scan signature seen first = scan signature seen second := by
  induction cell generalizing seen with
  | refl => rfl
  | exchange first second allowed rest => exact scan_exchange signature seen first second allowed rest
  | cons action cell ih =>
      cases action with
      | reveal input => exact ih (insert input seen)
      | commit key => by_cases available : signature key ⊆ seen <;> simp [InformationSchedule.scan, available, ih seen]
  | symm cell ih => exact (ih seen).symm
  | trans first second ihFirst ihSecond => exact (ihFirst seen).trans (ihSecond seen)

theorem Cell.continuation {Result : Type} {first second} (cell : Cell signature first second)
    (state : State Variable Key Choice) (next : State Variable Key Choice → PMF Result) :
    (run signature policy first state).bind next = (run signature policy second state).bind next := by
  rw [Cell.sound signature policy cell state]

/-- Includes the original hidden values and the original chosen commitments. -/
theorem Cell.joint {Context : Type} {first second} (cell : Cell signature first second)
    (source : PMF (Context × State Variable Key Choice)) :
    (source.bind fun original => (run signature policy first original.2).map (fun final => (original, final))) =
      (source.bind fun original => (run signature policy second original.2).map (fun final => (original, final))) := by
  simp_rw [Cell.sound signature policy cell]

end CryptoOracle.InformationSchedule
