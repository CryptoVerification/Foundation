import Foundation.Crypto.Logic.Polygraph.MixedCircuit

/-! Local branching positions and constructive exchange squares for separated
rewrites. Root/root and nested overlaps remain explicit obligations; this
classification does not assert critical-pair completeness or finite coherence. -/
namespace CryptoLogic.Polygraph.MixedCircuit
open CryptoLogic.Polygraph.Experiment.GameCoherence.Requirements
variable {Box Requirement Budget Rule : Type} [DecidableEq Requirement]
variable {signature : Signature Box Requirement Budget} {relators : Rule → Relator signature}

inductive Direction where | seqLeft | seqRight | tensorLeft | tensorRight deriving DecidableEq, Repr

def Step.position : {n m : Port signature} → {a b : Circuit signature n m} → Step relators a b → List Direction
  | _, _, _, _, .root _ => []
  | _, _, _, _, .seqLeft child _ => .seqLeft :: child.position
  | _, _, _, _, .seqRight _ child => .seqRight :: child.position
  | _, _, _, _, .tensorLeft child _ => .tensorLeft :: child.position
  | _, _, _, _, .tensorRight _ child => .tensorRight :: child.position

/-- Separated positions are generated by the four ordered split squares and
congruence in the four circuit contexts. The local rewrites may be nested. -/
inductive Separated : {n m : Port signature} → {a b c : Circuit signature n m} → Step relators a b → Step relators a c → Type where
  | seqLR {n m k} {a a' : Circuit signature n m} {b b' : Circuit signature m k}
      (left : Step relators a a') (right : Step relators b b') :
      Separated (.seqLeft left b) (.seqRight a right)
  | seqRL {n m k} {a a' : Circuit signature n m} {b b' : Circuit signature m k}
      (left : Step relators a a') (right : Step relators b b') :
      Separated (.seqRight a right) (.seqLeft left b)
  | tensorLR {n m n' m'} {a a' : Circuit signature n m} {b b' : Circuit signature n' m'}
      (left : Step relators a a') (right : Step relators b b') :
      Separated (.tensorLeft left b) (.tensorRight a right)
  | tensorRL {n m n' m'} {a a' : Circuit signature n m} {b b' : Circuit signature n' m'}
      (left : Step relators a a') (right : Step relators b b') :
      Separated (.tensorRight a right) (.tensorLeft left b)
  | seqLeft {n m k} {a b c : Circuit signature n m} {s : Step relators a b} {t : Step relators a c}
      (separate : Separated s t) (fixed : Circuit signature m k) : Separated (.seqLeft s fixed) (.seqLeft t fixed)
  | seqRight {n m k} (fixed : Circuit signature n m) {a b c : Circuit signature m k}
      {s : Step relators a b} {t : Step relators a c} (separate : Separated s t) : Separated (.seqRight fixed s) (.seqRight fixed t)
  | tensorLeft {n m n' m'} {a b c : Circuit signature n m} {s : Step relators a b} {t : Step relators a c}
      (separate : Separated s t) (fixed : Circuit signature n' m') : Separated (.tensorLeft s fixed) (.tensorLeft t fixed)
  | tensorRight {n m n' m'} (fixed : Circuit signature n m) {a b c : Circuit signature n' m'}
      {s : Step relators a b} {t : Step relators a c} (separate : Separated s t) : Separated (.tensorRight fixed s) (.tensorRight fixed t)

structure Diamond {n m : Port signature} {a b c : Circuit signature n m} (first : Step relators a b) (second : Step relators a c) where
  target : Circuit signature n m
  afterFirst : Step relators b target
  afterSecond : Step relators c target

namespace Separated

def diamond : {n m : Port signature} → {a b c : Circuit signature n m} → {s : Step relators a b} → {t : Step relators a c} →
    Separated s t → Diamond s t
  | _, _, _, _, _, _, _, .seqLR left right => ⟨_, .seqRight _ right, .seqLeft left _⟩
  | _, _, _, _, _, _, _, .seqRL left right => ⟨_, .seqLeft left _, .seqRight _ right⟩
  | _, _, _, _, _, _, _, .tensorLR left right => ⟨_, .tensorRight _ right, .tensorLeft left _⟩
  | _, _, _, _, _, _, _, .tensorRL left right => ⟨_, .tensorLeft left _, .tensorRight _ right⟩
  | _, _, _, _, _, _, _, .seqLeft separate fixed =>
      let inner := separate.diamond
      ⟨.seq inner.target fixed, .seqLeft inner.afterFirst fixed, .seqLeft inner.afterSecond fixed⟩
  | _, _, _, _, _, _, _, .seqRight fixed separate =>
      let inner := separate.diamond
      ⟨.seq fixed inner.target, .seqRight fixed inner.afterFirst, .seqRight fixed inner.afterSecond⟩
  | _, _, _, _, _, _, _, .tensorLeft separate fixed =>
      let inner := separate.diamond
      ⟨.tensor inner.target fixed, .tensorLeft inner.afterFirst fixed, .tensorLeft inner.afterSecond fixed⟩
  | _, _, _, _, _, _, _, .tensorRight fixed separate =>
      let inner := separate.diamond
      ⟨.tensor fixed inner.target, .tensorRight fixed inner.afterFirst, .tensorRight fixed inner.afterSecond⟩

end Separated

/-- Computable classification; the overlap alternative carries its exact
prefix proof rather than claiming that overlapping roots are resolved. -/
inductive Branching {n m} {a b c : Circuit signature n m} (first : Step relators a b) (second : Step relators a c) where
  | overlap (positions : first.position.IsPrefix second.position ∨ second.position.IsPrefix first.position)
  | separate (witness : Separated first second)

def Step.branching : {n m : Port signature} → {a b c : Circuit signature n m} →
    (first : Step relators a b) → (second : Step relators a c) → Branching first second
  | _, _, _, _, _, .root _, _ => .overlap (.inl List.nil_prefix)
  | _, _, _, _, _, _, .root _ => .overlap (.inr List.nil_prefix)
  | _, _, _, _, _, .seqLeft change fixed, .seqLeft other _ =>
      match change.branching other with
      | .overlap positions => .overlap (positions.elim (fun h => .inl ((List.prefix_cons_inj _).mpr h))
          (fun h => .inr ((List.prefix_cons_inj _).mpr h)))
      | .separate apart => .separate (.seqLeft apart fixed)
  | _, _, _, _, _, .seqLeft change _, .seqRight _ other => .separate (.seqLR change other)
  | _, _, _, _, _, .seqRight _ change, .seqLeft other _ => .separate (.seqRL other change)
  | _, _, _, _, _, .seqRight fixed change, .seqRight _ other =>
      match change.branching other with
      | .overlap positions => .overlap (positions.elim (fun h => .inl ((List.prefix_cons_inj _).mpr h))
          (fun h => .inr ((List.prefix_cons_inj _).mpr h)))
      | .separate apart => .separate (.seqRight fixed apart)
  | _, _, _, _, _, .tensorLeft change fixed, .tensorLeft other _ =>
      match change.branching other with
      | .overlap positions => .overlap (positions.elim (fun h => .inl ((List.prefix_cons_inj _).mpr h))
          (fun h => .inr ((List.prefix_cons_inj _).mpr h)))
      | .separate apart => .separate (.tensorLeft apart fixed)
  | _, _, _, _, _, .tensorLeft change _, .tensorRight _ other => .separate (.tensorLR change other)
  | _, _, _, _, _, .tensorRight _ change, .tensorLeft other _ => .separate (.tensorRL other change)
  | _, _, _, _, _, .tensorRight fixed change, .tensorRight _ other =>
      match change.branching other with
      | .overlap positions => .overlap (positions.elim (fun h => .inl ((List.prefix_cons_inj _).mpr h))
          (fun h => .inr ((List.prefix_cons_inj _).mpr h)))
      | .separate apart => .separate (.tensorRight fixed apart)

omit [DecidableEq Requirement] in
/-- Every branching is covered; positional overlaps remain obligations. -/
theorem Step.classify {n m} {a b c : Circuit signature n m} (first : Step relators a b) (second : Step relators a c) :
    first.position.IsPrefix second.position ∨ second.position.IsPrefix first.position ∨ Nonempty (Separated first second) := by
  cases first.branching second with
  | overlap positions => exact positions.elim Or.inl (fun h => Or.inr (Or.inl h))
  | separate witness => exact Or.inr (Or.inr ⟨witness⟩)

namespace Separated

omit [DecidableEq Requirement] in
theorem incomparable {n m} {a b c : Circuit signature n m} {first : Step relators a b} {second : Step relators a c}
    (separate : Separated first second) :
    ¬ first.position.IsPrefix second.position ∧ ¬ second.position.IsPrefix first.position := by
  induction separate with
  | seqLR | seqRL | tensorLR | tensorRL =>
      simp [Step.position, List.IsPrefix]
  | seqLeft separate fixed ih | seqRight fixed separate ih | tensorLeft separate fixed ih | tensorRight fixed separate ih =>
      simpa only [Step.position, List.prefix_cons_inj] using ih

/-- Commuting separated changes introduces no extra guard beyond their
original whole-step support, including the unmodified surrounding boxes. -/
theorem no_new_conditions {n m} {a b c : Circuit signature n m} {first : Step relators a b} {second : Step relators a c}
    (separate : Separated first second) :
    separate.diamond.afterFirst.support ⊆ first.support ∪ second.support ∧
      separate.diamond.afterSecond.support ⊆ first.support ∪ second.support := by
  induction separate with
  | seqLR left right | seqRL left right | tensorLR left right | tensorRL left right =>
      rcases left.boundaries with ⟨leftSource, leftTarget⟩
      rcases right.boundaries with ⟨rightSource, rightTarget⟩
      simp only [diamond, Step.support]
      constructor <;> intro label member <;> simp only [Finset.mem_union] at member ⊢ <;> aesop
  | seqLeft separate fixed ih | tensorLeft separate fixed ih =>
      constructor
      · simpa only [diamond, Step.support, Finset.union_assoc, Finset.union_left_comm, Finset.union_comm, Finset.union_left_idem] using
          Finset.union_subset_union ih.1 (Finset.Subset.refl fixed.needs)
      · simpa only [diamond, Step.support, Finset.union_assoc, Finset.union_left_comm, Finset.union_comm, Finset.union_left_idem] using
          Finset.union_subset_union ih.2 (Finset.Subset.refl fixed.needs)
  | seqRight fixed separate ih | tensorRight fixed separate ih =>
      constructor
      · simpa only [diamond, Step.support, Finset.union_assoc, Finset.union_left_comm, Finset.union_comm, Finset.union_left_idem] using
          Finset.union_subset_union (Finset.Subset.refl fixed.needs) ih.1
      · simpa only [diamond, Step.support, Finset.union_assoc, Finset.union_left_comm, Finset.union_comm, Finset.union_left_idem] using
          Finset.union_subset_union (Finset.Subset.refl fixed.needs) ih.2

end Separated

omit [DecidableEq Requirement] in
theorem Step.separated_iff {n m} {a b c : Circuit signature n m} (first : Step relators a b) (second : Step relators a c) :
    Nonempty (Separated first second) ↔
      ¬ first.position.IsPrefix second.position ∧ ¬ second.position.IsPrefix first.position := by
  constructor
  · rintro ⟨separate⟩; exact separate.incomparable
  · intro incomparable
    rcases first.classify second with left | right | apart
    · exact False.elim (incomparable.1 left)
    · exact False.elim (incomparable.2 right)
    · exact apart

/-- Executable separated-square construction. Nested/root overlaps return
none, so failure is not a claim that those diagrams are inequivalent. -/
def Step.commute {n m} {a b c : Circuit signature n m} (first : Step relators a b) (second : Step relators a c) :
    Option (Diamond first second) :=
  match first.branching second with
  | .overlap _ => none
  | .separate witness => some witness.diamond

omit [DecidableEq Requirement] in
theorem Step.commute_complete {n m} {a b c : Circuit signature n m} (first : Step relators a b) (second : Step relators a c) :
    (first.commute second).isSome = true ↔
      ¬ first.position.IsPrefix second.position ∧ ¬ second.position.IsPrefix first.position := by
  cases comparison : first.branching second with
  | overlap positions =>
      simp only [commute, comparison, Option.isSome_none, Bool.false_eq_true, false_iff]
      intro incomparable
      exact positions.elim incomparable.1 incomparable.2
  | separate witness =>
      simp only [commute, comparison, Option.isSome_some, true_iff]
      exact witness.incomparable

theorem Step.commute_no_new_conditions {n m} {a b c : Circuit signature n m} (first : Step relators a b) (second : Step relators a c)
    (square : Diamond first second) (returned : first.commute second = some square) :
    square.afterFirst.support ⊆ first.support ∪ second.support ∧
      square.afterSecond.support ⊆ first.support ∪ second.support := by
  cases comparison : first.branching second with
  | overlap positions => simp only [commute, comparison, reduceCtorEq] at returned
  | separate witness =>
      have same : witness.diamond = square := Option.some.inj (by simpa only [commute, comparison] using returned)
      cases same
      exact witness.no_new_conditions

/-- All four sides compare the complete input-indexed kernels. No claim of
proof-term equality or completeness of the local-rule catalogue is made. -/
def Diamond.Meaning {condition : Requirement → Prop} {Value : signature.PortAtom → Type}
    (model : CheckedModel relators condition Value) {n m} {a b c : Circuit signature n m}
    {first : Step relators a b} {second : Step relators a c} (square : Diamond first second) : Prop :=
  ∃ sourceValid : Holds condition a.needs, ∃ firstValid : Holds condition b.needs,
    ∃ secondValid : Holds condition c.needs, ∃ targetValid : Holds condition square.target.needs,
      ∀ input, (evaluate model.base a sourceValid input = evaluate model.base b firstValid input) ∧
        (evaluate model.base a sourceValid input = evaluate model.base c secondValid input) ∧
        (evaluate model.base b firstValid input = evaluate model.base square.target targetValid input) ∧
        (evaluate model.base c secondValid input = evaluate model.base square.target targetValid input)

theorem Step.commute_sound {condition : Requirement → Prop} {Value : signature.PortAtom → Type}
    (model : CheckedModel relators condition Value) {n m} {a b c : Circuit signature n m}
    (first : Step relators a b) (second : Step relators a c) (square : Diamond first second)
    (returned : first.commute second = some square) (valid : Holds condition (first.support ∪ second.support)) :
    square.Meaning model := by
  have covered := first.commute_no_new_conditions second square returned
  let firstGuard := valid.restrict Finset.subset_union_left
  let secondGuard := valid.restrict Finset.subset_union_right
  let afterFirstGuard := valid.restrict covered.1
  let afterSecondGuard := valid.restrict covered.2
  refine ⟨firstGuard.restrict first.boundaries.1, firstGuard.restrict first.boundaries.2,
    secondGuard.restrict second.boundaries.2, afterFirstGuard.restrict square.afterFirst.boundaries.2, ?_⟩
  intro input
  exact ⟨first.sound model firstGuard _ _ input, second.sound model secondGuard _ _ input,
    square.afterFirst.sound model afterFirstGuard _ _ input, square.afterSecond.sound model afterSecondGuard _ _ input⟩

theorem Step.commute_repaired {old updated : Requirement → Prop} {Value : signature.PortAtom → Type}
    (model : CheckedModel relators updated Value) {n m} {a b c : Circuit signature n m}
    (first : Step relators a b) (second : Step relators a c) (square : Diamond first second)
    (returned : first.commute second = some square) (changed : Finset Requirement)
    (cached : Holds old (first.support ∪ second.support))
    (unchanged : ∀ label ∉ changed, old label → updated label)
    (rechecked : Holds updated (fresh (first.support ∪ second.support) changed)) : square.Meaning model :=
  first.commute_sound model second square returned (repair cached unchanged rechecked)

end CryptoLogic.Polygraph.MixedCircuit
