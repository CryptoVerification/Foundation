import Foundation.Logic.Polygraph.StructuralCartesianOneHole
import Foundation.Logic.Polygraph.FiniteCompletion
import Foundation.Logic.Polygraph.FourNaturality

/-! Transport the already certified finite composition coherence into actual
wire proof paths. Atom interpretations may be arbitrary typed pure wires.
Only paths generated by the source composition syntax are claimed coherent;
arbitrary cartesian or tensor-internal proof paths are not covered. -/
namespace Foundation.Logic.Polygraph.StructuralTransport.Cartesian.Higher.CategoryCritical.CompositionTransport
variable {Atom : Type} {E : Shape Atom → Shape Atom → Type}
set_option backward.isDefEq.respectTransparency false

def evaluate (interpret : ∀ {a b}, E a b → Wire a b) :
    {a b : Shape Atom} → Composition.Expr E a b → Wire a b
  | _, _, .identity a => .identity a
  | _, _, .atom edge => interpret edge
  | _, _, .seq first second => .seq (evaluate interpret first) (evaluate interpret second)

def edge (interpret : ∀ {a b}, E a b → Wire a b) : {a b : Shape Atom} →
    {p q : Composition.Expr E a b} → Composition.Expr.Step p q → Step (evaluate interpret p) (evaluate interpret q)
  | _, _, _, _, .assoc p q r => associate (evaluate interpret p) (evaluate interpret q) (evaluate interpret r)
  | _, _, _, _, .leftUnit p => leftUnit (evaluate interpret p)
  | _, _, _, _, .rightUnit p => rightUnit (evaluate interpret p)
  | _, _, _, _, .left child fixed => .seqLeft (edge interpret child) (evaluate interpret fixed)
  | _, _, _, _, .right fixed child => .seqRight (evaluate interpret fixed) (edge interpret child)

def track (interpret : ∀ {a b}, E a b → Wire a b) {a b : Shape Atom} {p q : Composition.Expr E a b}
    (path : Composition.Finite.Three p q) : ProofTrack (evaluate interpret p) (evaluate interpret q) :=
  path.map (evaluate interpret) (fun change => edge interpret change)

private def padTwo {a b : Shape Atom} {p q r : Wire a b} (one : Step p q) (two : Step q r) :
    Cell (.comp (.step one) (.comp (.step two) (.refl r))) (CategoryCritical.two one two) :=
  Four.comp (.refl _) (Four.rightUnit _)

private def padThree {a b : Shape Atom} {p q r s : Wire a b}
    (one : Step p q) (two : Step q r) (three : Step r s) :
    Cell (.comp (.step one) (.comp (.step two) (.comp (.step three) (.refl s))))
      (CategoryCritical.three one two three) := Four.comp (.refl _) (padTwo two three)

def generator (interpret : ∀ {a b}, E a b → Wire a b) : {a b : Shape Atom} →
    {p q : Composition.Expr E a b} → {first second : Composition.Finite.Three p q} →
    Composition.Finite.Generator first second → Cell (track interpret first) (track interpret second)
  | _, _, _, _, _, _, .pentagon p q r s =>
      (padTwo _ _).trans ((pentagonCell (evaluate interpret p) (evaluate interpret q)
        (evaluate interpret r) (evaluate interpret s)).trans (padThree _ _ _).symm)
  | _, _, _, _, _, _, .assocLeftUnit p q =>
      (padTwo _ _).trans ((leftUnitCell (evaluate interpret p) (evaluate interpret q)).trans (Four.rightUnit _).symm)
  | _, _, _, _, _, _, .assocMiddleUnit p q =>
      (padTwo _ _).trans ((middleUnitCell (evaluate interpret p) (evaluate interpret q)).trans (Four.rightUnit _).symm)
  | _, _, _, _, _, _, .assocRightUnit p q =>
      (padTwo _ _).trans ((rightUnitCell (evaluate interpret p) (evaluate interpret q)).trans (Four.rightUnit _).symm)
  | _, _, _, _, _, _, .units a =>
      (Four.rightUnit _).trans ((unitCell a).trans (Four.rightUnit _).symm)
  | _, _, _, _, _, _, .leftUnitNatural change =>
      (padTwo _ _).trans ((leftNatural (edge interpret change)).trans (padTwo _ _).symm)
  | _, _, _, _, _, _, .rightUnitNatural change =>
      (padTwo _ _).trans ((rightNatural (edge interpret change)).trans (padTwo _ _).symm)
  | _, _, _, _, _, _, .assocNaturalFirst change q r =>
      (padTwo _ _).trans ((assocFirstNatural (edge interpret change) (evaluate interpret q)
        (evaluate interpret r)).trans (padTwo _ _).symm)
  | _, _, _, _, _, _, .assocNaturalSecond p change r =>
      (padTwo _ _).trans ((assocMiddleNatural (evaluate interpret p) (edge interpret change)
        (evaluate interpret r)).trans (padTwo _ _).symm)
  | _, _, _, _, _, _, .assocNaturalThird p q change =>
      (padTwo _ _).trans ((assocLastNatural (evaluate interpret p) (evaluate interpret q)
        (edge interpret change)).trans (padTwo _ _).symm)
  | _, _, _, _, _, _, .exchange first second =>
      (padTwo _ _).trans ((oldLift (.generator (.seqExchange (edge interpret first) (edge interpret second)))).trans
        (padTwo _ _).symm)

def law (interpret : ∀ {a b}, E a b → Wire a b) {a b : Shape Atom} :
    {p q : Composition.Expr E a b} → {first second : Composition.Finite.Three p q} →
    Four (fun {_ _} _ _ => PEmpty.{1}) first second → Cell (track interpret first) (track interpret second)
  | _, _, _, _, .refl path => .refl (track interpret path)
  | _, _, _, _, .generator impossible => nomatch impossible
  | _, _, _, _, .symm child => (law interpret child).symm
  | _, _, _, _, .trans first second => (law interpret first).trans (law interpret second)
  | _, _, _, _, .comp first second => .comp (law interpret first) (law interpret second)
  | _, _, _, _, .inverse child => .inverse (law interpret child)
  | _, _, _, _, .assoc p q r => .assoc (track interpret p) (track interpret q) (track interpret r)
  | _, _, _, _, .leftUnit path => .leftUnit (track interpret path)
  | _, _, _, _, .rightUnit path => .rightUnit (track interpret path)
  | _, _, _, _, .leftInv path => .leftInv (track interpret path)
  | _, _, _, _, .rightInv path => .rightInv (track interpret path)

theorem track_left (interpret : ∀ {a b}, E a b → Wire a b) {a b c : Shape Atom}
    {p q : Composition.Expr E a b} (path : Composition.Finite.Three p q) (fixed : Composition.Expr E b c) :
    track interpret (Composition.Finite.left path fixed) = seqLeftTrack (evaluate interpret fixed) (track interpret path) := by
  simp only [track, Composition.Finite.left, seqLeftTrack, FourNaturality.map_map, evaluate, edge]

theorem track_right (interpret : ∀ {a b}, E a b → Wire a b) {a b c : Shape Atom}
    (fixed : Composition.Expr E a b) {p q : Composition.Expr E b c} (path : Composition.Finite.Three p q) :
    track interpret (Composition.Finite.right fixed path) = seqRightTrack (evaluate interpret fixed) (track interpret path) := by
  simp only [track, Composition.Finite.right, seqRightTrack, FourNaturality.map_map, evaluate, edge]

def cell (interpret : ∀ {a b}, E a b → Wire a b) {a b : Shape Atom} :
    {p q : Composition.Expr E a b} → {first second : Composition.Finite.Three p q} →
    Composition.Finite.Cell4 first second → Cell (track interpret first) (track interpret second)
  | _, _, _, _, .generator root => generator interpret root
  | _, _, _, _, .law proof => law interpret proof
  | _, _, _, _, .symm child => (cell interpret child).symm
  | _, _, _, _, .trans first second => (cell interpret first).trans (cell interpret second)
  | _, _, _, _, .comp first second => .comp (cell interpret first) (cell interpret second)
  | _, _, _, _, .inverse child => .inverse (cell interpret child)
  | _, _, _, _, .left child fixed => by
      rw [track_left, track_left]
      exact CategoryCritical.whisker (.seqLeft (evaluate interpret fixed)) (cell interpret child)
  | _, _, _, _, .right fixed child => by
      rw [track_right, track_right]
      exact CategoryCritical.whisker (.seqRight (evaluate interpret fixed)) (cell interpret child)

/-- Reuse the existing finite source theorem, with all its local diagrams
translated into actual wire comparisons rather than supplied as a new root. -/
def coherent (interpret : ∀ {a b}, E a b → Wire a b) {a b : Shape Atom} {p q : Composition.Expr E a b}
    (first second : Composition.Finite.Three p q) : Cell (track interpret first) (track interpret second) :=
  cell interpret (Composition.Finite.coherent first second)

end Foundation.Logic.Polygraph.StructuralTransport.Cartesian.Higher.CategoryCritical.CompositionTransport
