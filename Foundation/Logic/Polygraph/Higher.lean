import Foundation.Logic.Polygraph.Rewriting

/-! Four-cells freely generated by specified parallel three-paths and the
groupoid laws. These are data, not Lean equality proofs. A normalization
completion has one square per rewrite instance; it is not a claim that a
finite list of critical branchings generates every coherence. -/
namespace Foundation.Logic.Polygraph

universe u v w

inductive Four {A : Type u} {R : A → A → Type v}
    (G : {a b : A} → Track R a b → Track R a b → Type w) :
    {a b : A} → Track R a b → Track R a b → Type (max u v w) where
  | refl {a b} (p : Track R a b) : Four G p p
  | generator {a b} {p q : Track R a b} : G p q → Four G p q
  | symm {a b} {p q : Track R a b} : Four G p q → Four G q p
  | trans {a b} {p q r : Track R a b} : Four G p q → Four G q r → Four G p r
  | comp {a b c} {p p' : Track R a b} {q q' : Track R b c} :
      Four G p p' → Four G q q' → Four G (.comp p q) (.comp p' q')
  | inverse {a b} {p q : Track R a b} : Four G p q → Four G (.inv p) (.inv q)
  | assoc {a b c d} (p : Track R a b) (q : Track R b c) (r : Track R c d) :
      Four G (.comp (.comp p q) r) (.comp p (.comp q r))
  | leftUnit {a b} (p : Track R a b) : Four G (.comp (.refl a) p) p
  | rightUnit {a b} (p : Track R a b) : Four G (.comp p (.refl b)) p
  | leftInv {a b} (p : Track R a b) : Four G (.comp (.inv p) p) (.refl b)
  | rightInv {a b} (p : Track R a b) : Four G (.comp p (.inv p)) (.refl a)

/-- A normalizing completion of a connected component. The target and each
normalizing path must be constructed first; they are not postulated by Four. -/
inductive NormalSquare {A : Type u} {R : A → A → Type v} (target : A)
    (normal : ∀ a, Track R a target) :
    {a b : A} → Track R a b → Track R a b → Type (max u v) where
  | step {a b} (s : R a b) :
      NormalSquare target normal (.comp (.step s) (normal b)) (normal a)

namespace NormalSquare

variable {A : Type u} {R : A → A → Type v} {target : A}
  (normal : ∀ a, Track R a target)

abbrev Homotopy {a b : A} (p q : Track R a b) := Four (NormalSquare target normal) p q

/-- A recursively constructed four-cell contracts every path followed by
normalization. Only single-rewrite squares and groupoid laws are used. -/
def contract : {a b : A} → (p : Track R a b) →
    Homotopy normal (.comp p (normal b)) (normal a)
  | _, _, .refl _ => .leftUnit _
  | _, _, .step s => .generator (.step s)
  | _, _, .comp p q =>
      (Four.assoc (G := NormalSquare target normal) p q _).trans ((Four.comp (Four.refl p) (contract q)).trans (contract p))
  | _, _, .inv p =>
      (Four.comp (Four.refl (.inv p)) (contract p).symm).trans
        ((Four.assoc (G := NormalSquare target normal) (.inv p) p _).symm.trans
          ((Four.comp (Four.leftInv p) (Four.refl _)).trans (Four.leftUnit _)))

def factor {a b : A} (p : Track R a b) :
    Homotopy normal p (.comp (normal a) (.inv (normal b))) :=
  (Four.rightUnit (G := NormalSquare target normal) p).symm.trans
    ((Four.comp (Four.refl p) (Four.rightInv (normal b)).symm).trans
      ((Four.assoc (G := NormalSquare target normal) p (normal b) (.inv (normal b))).symm.trans
        (Four.comp (contract normal p) (Four.refl _))))

/-- Any parallel paths in this completed component have a four-cell. This
does not identify arbitrary inference diagrams or arbitrary security proofs. -/
def coherent {a b : A} (p q : Track R a b) : Homotopy normal p q :=
  (factor normal p).trans (factor normal q).symm

end NormalSquare
end Foundation.Logic.Polygraph
