import Foundation.Crypto.Semantics.Probability.Facts
import Mathlib.Data.Rat.Defs

/-! A feasibility test for an obstruction-based non-realizability argument.
All two-coordinate marginals of the prescribed three-bit laws are uniform,
but no nonnegative four-bit law realizes all four three-bit laws.
This is a higher-arity marginal obstruction, NOT an H² computation or a
black-box cryptographic separation. The simulator theorem only excludes
context-independent, common-output finite-seed simulators with the displayed
local laws. It does not prove that cryptographic reductions must have them. -/
namespace Foundation.Examples.HigherMarginalObstruction
open scoped BigOperators

abbrev Triple := Bool × Bool × Bool
abbrev Quad := Bool × Bool × Bool × Bool

def drop (face : Fin 4) (x : Quad) : Triple :=
  match face.val with
  | 0 => (x.2.1, x.2.2.1, x.2.2.2)
  | 1 => (x.1, x.2.2.1, x.2.2.2)
  | 2 => (x.1, x.2.1, x.2.2.2)
  | _ => (x.1, x.2.1, x.2.2.1)

def pair (coordinate : Fin 3) (x : Triple) : Bool × Bool :=
  match coordinate.val with
  | 0 => (x.2.1, x.2.2)
  | 1 => (x.1, x.2.2)
  | _ => (x.1, x.2.1)

/-- Uniform sharing of zero into three XOR shares. -/
def target (x : Triple) : ℚ :=
  if Bool.xor x.1 (Bool.xor x.2.1 x.2.2) then 0 else 1 / 4

def score : Triple → ℚ
  | (false, false, false) => 0
  | (true, false, false) | (false, true, false) | (false, false, true) => -1
  | (true, true, false) | (true, false, true) | (false, true, true) => 1
  | (true, true, true) => -3

theorem target_nonnegative : ∀ x, 0 ≤ target x := by
  rintro ⟨a, b, c⟩
  cases a <;> cases b <;> cases c <;> norm_num [target]
theorem target_normalized : ∑ x, target x = 1 := by
  norm_num [Fintype.sum_prod_type, Fintype.sum_bool, target]

/-- Every pair, including overlaps of distinct prescribed triple contexts,
has the same independent uniform law. Pairwise checks cannot refute the task. -/
theorem target_pairs_uniform : ∀ coordinate value,
    (∑ x, if pair coordinate x = value then target x else 0) = (1 / 4 : ℚ) := by
  intro coordinate ⟨a, b⟩
  fin_cases coordinate <;> cases a <;> cases b <;>
    norm_num [Fintype.sum_prod_type, Fintype.sum_bool, pair, target]

theorem target_score : ∑ x, target x * score x = (3 / 4 : ℚ) := by
  norm_num [Fintype.sum_prod_type, Fintype.sum_bool, target, score]

/-- Finite dual certificate, checked on every four-bit assignment. -/
theorem global_score_nonpositive : ∀ x, (∑ face, score (drop face x)) ≤ 0 := by
  rintro ⟨a, b, c, d⟩
  cases a <;> cases b <;> cases c <;> cases d <;>
    norm_num [Fin.sum_univ_succ, drop, score]

def marginal (weights : Quad → ℚ) (face : Fin 4) (value : Triple) : ℚ :=
  ∑ x, if drop face x = value then weights x else 0

theorem marginal_score (weights : Quad → ℚ) (face : Fin 4) :
    ∑ value, marginal weights face value * score value =
      ∑ x, weights x * score (drop face x) := by
  simp only [marginal, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  simp [eq_comm]

/-- Nonnegativity is essential: this is not only a linear compatibility test. -/
theorem realized_score_nonpositive (weights : Quad → ℚ) (nonnegative : ∀ x, 0 ≤ weights x) :
    (∑ face, ∑ value, marginal weights face value * score value) ≤ 0 := by
  simp_rw [marginal_score]
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum]
  exact Finset.sum_nonpos fun x _ =>
    mul_nonpos_of_nonneg_of_nonpos (nonnegative x) (global_score_nonpositive x)

theorem no_joint : ¬∃ weights : Quad → ℚ, (∀ x, 0 ≤ weights x) ∧
    ∀ face value, marginal weights face value = target value := by
  rintro ⟨weights, nonnegative, localLaws⟩
  have impossible := realized_score_nonpositive weights nonnegative
  simp_rw [localLaws, target_score] at impossible
  norm_num at impossible

/-- A common output generated by one finite random seed necessarily induces
a global nonnegative law. This implication is proved, not included as a
global-realizability premise in the simulator interface. -/
def pushforward {Seed : Type} [Fintype Seed] (weight : Seed → ℚ) (output : Seed → Quad)
    (x : Quad) : ℚ := ∑ seed, if output seed = x then weight seed else 0

theorem pushforward_nonnegative {Seed : Type} [Fintype Seed] (weight : Seed → ℚ)
    (output : Seed → Quad) (nonnegative : ∀ seed, 0 ≤ weight seed) :
    ∀ x, 0 ≤ pushforward weight output x := by
  intro x
  apply Finset.sum_nonneg
  intro seed _
  split_ifs
  · exact nonnegative seed
  · exact le_rfl

theorem pushforward_marginal {Seed : Type} [Fintype Seed] (weight : Seed → ℚ)
    (output : Seed → Quad) (face : Fin 4) (value : Triple) :
    marginal (pushforward weight output) face value =
      ∑ seed, if drop face (output seed) = value then weight seed else 0 := by
  classical
  unfold marginal pushforward
  have distribute (x : Quad) :
      (if drop face x = value then ∑ seed, if output seed = x then weight seed else 0 else 0) =
        ∑ seed, if output seed = x then (if drop face x = value then weight seed else 0) else 0 := by
    by_cases selected : drop face x = value <;> simp [selected]
  simp_rw [distribute]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro seed _
  simp [eq_comm]

/-- Excludes every finite-seed implementation with four context-independent
outputs and the required triple laws. It says nothing about implementations
allowed to choose different outputs for different triple contexts. -/
theorem no_common_output_simulator {Seed : Type} [Fintype Seed] (weight : Seed → ℚ)
    (nonnegative : ∀ seed, 0 ≤ weight seed) (output : Seed → Quad)
    (localLaws : ∀ face value,
      (∑ seed, if drop face (output seed) = value then weight seed else 0) = target value) : False := by
  apply no_joint
  refine ⟨pushforward weight output, pushforward_nonnegative weight output nonnegative, ?_⟩
  intro face value
  rw [pushforward_marginal]
  exact localLaws face value

/-- A context-aware simulator escapes: after the triple context is chosen,
two fair bits generate its required share distribution exactly. -/
def contextOutput (seed : Bool × Bool) : Triple :=
  (seed.1, seed.2, Bool.xor seed.1 seed.2)

theorem context_aware_exact : ∀ value,
    (∑ seed, if contextOutput seed = value then (1 / 4 : ℚ) else 0) = target value := by
  rintro ⟨a, b, c⟩
  cases a <;> cases b <;> cases c <;>
    norm_num [Fintype.sum_prod_type, Fintype.sum_bool, contextOutput, target]

/-- Some global assignment lies in every local support. Thus a mere absence
of globally compatible assignments is not the certificate used above. -/
theorem support_has_global_assignment : ∀ face, 0 < target (drop face (false, false, false, false)) := by
  intro face
  fin_cases face <;> norm_num [drop, target]

end Foundation.Examples.HigherMarginalObstruction
